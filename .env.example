# Data backend: intel (GrowthX intel knowledge graph, read-only) | fixtures (bundled example data, default).
DATA_SOURCE=fixtures
# USE_FIXTURES=1 forces fixtures regardless of DATA_SOURCE.
USE_FIXTURES=1

# Postgres connection string for the Supabase project hosting schema `intel`.
# Prefer a SELECT-only role. The app only issues SELECTs inside READ ONLY transactions.
INTEL_DATABASE_URL=
INTEL_CITY=San Francisco

# Optional LLM (goal -> filters, ranking reasons, intros). Without keys: deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: public origin for the landing page MCP URL (e.g. https://growthx-mcp.vercel.app)
NEXT_PUBLIC_SITE_URL=
